# 管理员口令，用于登录 POST /api/login（必填，长度 >= 16 字符）。
# 未设置或长度不足时进程启动即报错退出（fail closed），不会以裸写接口启动。
# 口令只在登录时校验一次，登录后写接口凭会话 Cookie 直接通过。
ADMIN_TOKEN=

# 会话 Cookie 的签名密钥（可选，默认由 ADMIN_TOKEN 派生）。
# 轮换该值会让所有已登录会话立即失效，可作为「强制下线」手段。
SESSION_SECRET=

# 单 IP 每 15 分钟窗口允许的写请求次数（可选，默认 50）。
WRITE_RATE_LIMIT_MAX=50

# SQLite 定时备份间隔，单位小时（可选，默认 6）。
BACKUP_INTERVAL_HOURS=6

# 备份轮转保留份数，仅保留最新 N 份（可选，默认 7）。
BACKUP_KEEP=7
