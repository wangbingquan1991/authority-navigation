#!/usr/bin/env bash
# ============================================================
# 推送前敏感信息扫描 — git pre-push 钩子
# ============================================================
# 自动运行：
#   首次需启用一次（每个克隆各做一次）：
#     git config core.hooksPath .githooks
#   之后每次 git push 自动触发，发现敏感信息即中止推送。
#
# 手动运行：
#   .githooks/pre-push --range HEAD~1..HEAD   # 检查指定范围
#   .githooks/pre-push --range HEAD           # 检查最近一次提交
#
# 输出只报告「类型 + 文件 + 行号」，不回显匹配到的内容本身，
# 避免扫描日志成为新的泄露渠道。
#
# 紧急跳过：git push --no-verify
# ============================================================
set -uo pipefail

LOCAL_USER="$(basename "${HOME:-home}")"
EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || echo '4b825dc642cb6eb9a060e54bf8d69288fbee4904')"

if [ -t 1 ]; then
  RED=$'\033[31m'; YEL=$'\033[33m'; GRN=$'\033[32m'; OFF=$'\033[0m'
else
  RED=""; YEL=""; GRN=""; OFF=""
fi

errors=0
warns=0

ERR()  { errors=$((errors + 1)); printf '  %s✗ %s%s\n' "$RED" "$1" "$OFF"; }
WARN() { warns=$((warns + 1));  printf '  %s! %s%s\n' "$YEL" "$1" "$OFF"; }

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# ------------------------------------------------------------
# 预先读取 .env 中的密钥值，用于比对（只报键名，不回显值）
# ------------------------------------------------------------
ENV_SECRETS=""
if [ -f ".env" ]; then
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    val="${val%\"}"; val="${val#\"}"
    val="${val%\'}"; val="${val#\'}"
    [ "${#val}" -ge 16 ] || continue
    ENV_SECRETS="${ENV_SECRETS}${key}"$'\t'"${val}"$'\n'
  done < ".env"
fi

# ------------------------------------------------------------
# 单文件内容扫描
# ------------------------------------------------------------
CUR_FILE=""
CUR_CONTENT=""

scan_content() {
  local label="$1" pattern="$2" level="$3"
  local hits lines
  hits="$(printf '%s\n' "$CUR_CONTENT" 2>/dev/null | grep -nE "$pattern" 2>/dev/null | head -5 || true)"
  [ -n "$hits" ] || return 0
  lines="$(printf '%s\n' "$hits" | cut -d: -f1 | tr '\n' ' ')"
  lines="${lines% }"
  if [ "$level" = "error" ]; then
    ERR "${label} → ${CUR_FILE}（第 ${lines} 行）"
  else
    WARN "${label} → ${CUR_FILE}（第 ${lines} 行）"
  fi
}

# 与 .env 中的密钥值逐字比对
scan_env_values() {
  [ -n "$ENV_SECRETS" ] || return 0
  local key val
  while IFS=$'\t' read -r key val; do
    [ -n "${val:-}" ] || continue
    if printf '%s' "$CUR_CONTENT" 2>/dev/null | grep -qF -- "$val"; then
      ERR "与 .env 中 ${key} 的值完全一致 → ${CUR_FILE}"
    fi
  done <<< "$ENV_SECRETS"
}

# ------------------------------------------------------------
# 确定待检查的提交范围
#   --range 模式：直接使用传入的 rev-range
#   pre-push 模式：从 stdin 读取 <local-ref> <local-sha> <remote-ref> <remote-sha>
# ------------------------------------------------------------
pairs=""
# 用制表符分隔 base / head / mode，避免 ref 中可能出现的字符造成解析歧义
add_pair() {
  pairs="${pairs}$1"$'\t'"$2"$'\t'"$3"$'\n'
}

if [ "${1:-}" = "--range" ] && [ -n "${2:-}" ]; then
  case "$2" in
    *..*) add_pair "${2%%..*}" "${2##*..}" existing ;;
    *)    add_pair "$(git rev-parse --verify --quiet "${2}^" 2>/dev/null || echo "$EMPTY_TREE")" "$2" existing ;;
  esac
else
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    # 全 0 表示删除分支，无需扫描
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    case "${remote_sha:-}" in
      *[!0]*) add_pair "$remote_sha" "$local_sha" existing ;;
      *)      add_pair "$EMPTY_TREE" "$local_sha" new ;;
    esac
  done
fi

if [ -z "$pairs" ]; then
  printf '%s\n' "${GRN}敏感信息检查通过（无需检查的提交）。${OFF}"
  exit 0
fi

printf '%s\n' "推送前敏感信息扫描..."

# ------------------------------------------------------------
# 逐范围检查
# ------------------------------------------------------------
while IFS=$'\t' read -r base head mode; do
  [ -n "${base:-}" ] || continue
  [ -n "${head:-}" ] || continue

  # ---- 提交身份（作者 / 提交者姓名与邮箱）----
  if [ "$mode" = "new" ]; then
    commits="$(git rev-list "$head" --not --remotes 2>/dev/null || true)"
  else
    commits="$(git rev-list "$base..$head" 2>/dev/null || true)"
  fi

  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    meta="$(git log -1 --format='%an%x1f%ae%x1f%cn%x1f%ce' "$sha" 2>/dev/null || true)"
    short="${sha:0:7}"
    if printf '%s' "$meta" | grep -qiE '@[A-Za-z0-9._-]*\.local'; then
      ERR "提交身份泄露本机名（${short} 的邮箱含 .local）"
    fi
    if [ "${#LOCAL_USER}" -ge 5 ] && printf '%s' "$meta" | grep -qi -- "$LOCAL_USER"; then
      WARN "提交身份中出现本机用户名（${short}）"
    fi
  done <<< "$commits"

  # ---- 新增的敏感文件 ----
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      *.example|*.sample|*.template) ;;
      .env|.env.*|*/.env|*/.env.*)
        ERR "提交了环境变量文件 → $f" ;;
      *.pem|*.key|*.crt|*.p12|*.pfx|*.crx|*.keystore|*.jks)
        ERR "提交了密钥/证书文件 → $f" ;;
      *.db|*.sqlite|*.sqlite3|*.log)
        ERR "提交了数据/日志文件 → $f" ;;
      data/*|*/data/*)
        ERR "提交了运行数据 → $f" ;;
    esac
  done <<< "$(git diff --name-only --diff-filter=A "$base" "$head" 2>/dev/null || true)"

  # ---- 变更文件的内容 ----
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    CUR_FILE="$f"
    CUR_CONTENT="$(git show "$head:$f" 2>/dev/null || true)"
    [ -n "$CUR_CONTENT" ] || continue
    # 跳过二进制文件：git 对二进制文件的 numstat 计数显示为 "-"
    # 注意：不能用 grep -q $'\x00' 判断，bash 变量无法保存 NUL，会退化成空模式而恒真
    case "$(git diff --numstat "$base" "$head" -- "$f" 2>/dev/null || true)" in
      -*) continue ;;
    esac

    scan_content "本机绝对路径" '/Users/[A-Za-z0-9._-]+/|/home/[A-Za-z0-9._-]+/' error
    scan_content "私钥内容" '-----BEGIN [A-Z ]*PRIVATE KEY-----' error
    scan_content "硬编码访问密钥" '(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{30,})' error
    scan_content "URL 中的长令牌" '[?&](token|access_token|apikey|api_key|secret|key)=[A-Za-z0-9._-]{24,}' error
    scan_content "内网 IP 地址" '(^|[^0-9.])(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})' warn
    scan_env_values
  done <<< "$(git diff --name-only --diff-filter=ACMR "$base" "$head" 2>/dev/null || true)"
done <<< "$pairs"

# ------------------------------------------------------------
# 结果
# ------------------------------------------------------------
if [ "$errors" -gt 0 ]; then
  printf '\n%s\n' "${RED}推送已中止：发现 ${errors} 处敏感信息。${OFF}"
  printf '%s\n' "  修复后重新提交；确需跳过时用 git push --no-verify"
  exit 1
fi

if [ "$warns" -gt 0 ]; then
  printf '\n%s\n' "${YEL}敏感信息检查通过，另有 ${warns} 处提醒。${OFF}"
else
  printf '\n%s\n' "${GRN}敏感信息检查通过。${OFF}"
fi
exit 0
